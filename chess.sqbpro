<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="chess.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2451"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="2" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="matches" custom_title="0" dock_id="6" table="4,7:mainmatches"/><table title="matches" custom_title="0" dock_id="7" table="4,7:mainmatches"/><table title="matches" custom_title="0" dock_id="8" table="4,7:mainmatches"/><table title="users" custom_title="0" dock_id="9" table="4,5:mainusers"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="matches" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="70"/><column index="3" value="70"/><column index="4" value="65"/><column index="5" value="99"/><column index="6" value="99"/><column index="7" value="90"/><column index="8" value="90"/><column index="9" value="159"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="users" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="71"/><column index="3" value="300"/><column index="4" value="175"/><column index="5" value="70"/><column index="6" value="68"/><column index="7" value="87"/><column index="8" value="91"/><column index="9" value="35"/><column index="10" value="300"/><column index="11" value="215"/><column index="12" value="159"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*"> SELECT m.*, 
               CASE 
                   WHEN m.player1_id = ? THEN u2.first_name || ' ' || u2.last_name
                   ELSE u1.first_name || ' ' || u1.last_name
               END as opponent_name,
               CASE
                   WHEN m.player1_id = ? THEN u2.id
                   ELSE u1.id
               END as opponent_id
        FROM matches m
        LEFT JOIN users u1 ON m.player1_id = u1.id
        LEFT JOIN users u2 ON m.player2_id = u2.id
        WHERE m.player1_id = 1 OR m.player2_id = 1
        ORDER BY m.played_at DESC
        LIMIT 10</sql><current_tab id="0"/></tab_sql></sqlb_project>
